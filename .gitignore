# Secrets
.env

# Photos and thumbnails — copied from Drive at import time, never committed.
# One exception: photos/Retail/ holds the 500px render thumbnails that
# import_photos.py generates — ~20 KB each, under 5 MB for the whole catalogue.
# They are committed so a `git pull` carries real images. The full-resolution
# originals under photos/originals/ stay out: 253 MB, and no design needs them.
photos/*
!photos/Retail/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Generated export — regenerate with scripts/export_wardrobe.py
export/

# Patch artefacts — the pre-patch original is in git history
*.bak
*.new

# Unzipped drops — the files that matter are copied into data/ and docs/
.incoming/

# Import run logs — the run says what it did on screen; the file is scratch
*.log
