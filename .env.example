# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Postgres connection. PG15 on port 5432, database `wardrobe`.
DATABASE_URL=postgresql://wardrobe_app:CHANGE_ME@localhost:5432/wardrobe

# Where photos are copied FROM. Read-only: nothing is ever written here.
PHOTO_SOURCE_ROOT=G:/My Drive/Claude stuff/Wardrobe Photos

# Where the app keeps its own copies (relative to the repo root, or absolute).
PHOTO_STORE=photos

# Web app host/port. 0.0.0.0 makes it reachable from your phone on the same wifi.
APP_HOST=127.0.0.1
APP_PORT=5005

# Local timezone for dates and timestamps.
APP_TIMEZONE=Australia/Sydney

# Set to 1 only for local development. Never with a tunnel running: the
# Werkzeug debugger is a remote Python console for anyone who can reach it.
APP_DEBUG=0

# Basic-auth gate. Leave both blank for no gate (localhost default). Set both
# before exposing the app through a tunnel.
AUTH_USER=
AUTH_PASSWORD=

# Flask session/flash signing. Any long random string.
SECRET_KEY=

# Anthropic API key for the recommendation engine. Get one at
# platform.claude.com. Server-side only: it must never reach the browser.
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# --- Cloudflare Access (Google sign-in) ----------------------------------
# Set all three and the app requires a verified Access token on every request,
# INCLUDING from localhost: cloudflared forwards to 127.0.0.1, so there is no
# way to tell tunnel traffic from local traffic by address, and a loopback
# exemption would reopen the hole. Leave CF_ACCESS_AUD blank for local dev.
#
# Team domain: Zero Trust dashboard -> Settings -> Custom Pages, or the
# <team>.cloudflareaccess.com you sign in at. No scheme.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# Application Audience (AUD) tag: Access -> Applications -> your app -> Overview.
CF_ACCESS_AUD=
# Who may in. Comma-separated. Empty means nobody, on purpose.
CF_ACCESS_ALLOWED_EMAILS=maxime.boucoiran@gmail.com
