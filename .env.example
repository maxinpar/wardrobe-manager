# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Postgres connection. PG15 on port 5432, database `wardrobe`.
DATABASE_URL=postgresql://wardrobe_app:CHANGE_ME@localhost:5432/wardrobe

# Where photos are copied FROM. Read-only: nothing is ever written here.
PHOTO_SOURCE_ROOT=G:/My Drive/Claude stuff/Wardrobe Photos

# Where the app keeps its own copies (relative to the repo root, or absolute).
PHOTO_STORE=photos

# Web app host/port. 0.0.0.0 makes it reachable from your phone on the same wifi.
APP_HOST=127.0.0.1
APP_PORT=5005

# Local timezone for dates and timestamps.
APP_TIMEZONE=Australia/Sydney
